#!/bin/bash
# Usage: ./try N   runs answers/taskN.sh like ./check does, inside the practice copy in dojo/.
here="$(cd "$(dirname "$0")" && pwd)"
[ -n "$1" ] || { echo "usage: ./try N   (N is the task number, for example ./try 1)" >&2; exit 2; }
[ -f "$here/answers/task$1.sh" ] || { echo "there is no file answers/task$1.sh" >&2; exit 2; }
export DOJO="$here/dojo" HOME="$here/dojo/home/hacker"
mkdir -p "$HOME" "$DOJO/tmp"
cd "$HOME" && exec bash "$here/answers/task$1.sh"
