#!/usr/bin/env python3
import re, subprocess
from pathlib import Path

def fail(msg):
    print("Not yet:", msg)
    raise SystemExit(1)

r = subprocess.run(["g++", "-std=c++17", "-Wall", "-Wextra", "-Werror", "pipe_demo.cpp", "-o", "pipe_demo"],
                   capture_output=True, text=True)
if r.returncode:
    fail("pipe_demo.cpp does not compile without warnings. Fix the first error below:\n" + r.stderr)
src = Path("pipe_demo.cpp").read_text()
src = re.sub(r"//[^\n]*|/\*.*?\*/", "", src, flags=re.S)  # ignore comments
for call in ("pipe", "fork", "write", "read", "close"):
    if not re.search(r"\b%s\s*\(" % call, src):
        fail("pipe_demo.cpp should use the POSIX call %s(...) (see the README)" % call)
if not re.search(r"\bwait(pid)?\s*\(", src):
    fail("the parent should wait for the child with wait(nullptr)")
try:
    r = subprocess.run(["./pipe_demo"], capture_output=True, text=True, timeout=5)
except subprocess.TimeoutExpired:
    fail("./pipe_demo hung (it did not finish). Each process must close the pipe end that it does not use. "
         "If not, read never sees the end of the data")
if r.returncode != 0:
    fail("./pipe_demo should exit with 0, got %d" % r.returncode)
lines = r.stdout.splitlines()
if lines.count("samples=64") != 1:
    fail("the output should contain the line samples=64 exactly once, got:\n" + r.stdout)
print("CHECK_OK")
